# ==============================================================================
# HOTEL PMS PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your credentials
# ==============================================================================

# --- Firebase Web SDK Credentials ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_ga4_measurement_id

# --- Hotel & Property Settings ---
VITE_PROPERTY_ID=prop_astha_01
VITE_HOTEL_NAME="HOTEL ASTHA"
VITE_HOTEL_CODE=ASTHA
VITE_CURRENCY_SYMBOL=₹
VITE_DEFAULT_TIMEZONE=Asia/Kolkata

# --- API & Dev Server Configuration ---
VITE_API_BASE_URL=http://localhost:5175
VITE_ENABLE_ANALYTICS=true
