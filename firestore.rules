rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hotel PMS Security Rules
    // Supports multi-tenant properties, root operational mirrors, and front desk operations

    // Properties Collection & all nested subcollections
    match /properties/{propertyId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Root-level mirror collections (reservations, rooms, roomTypes, mealPlans, ratePlans, folios, guests, teamMembers, settings)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
